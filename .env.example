# Copy this file to .env.local for local development.
# In Vercel: set these under Project → Settings → Environment Variables.

# ── Required ────────────────────────────────────────────────────────────────

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Resend — resend.com → API Keys (free tier: 3 000 emails/month)
RESEND_API_KEY=

# ── Optional: LangSmith tracing ─────────────────────────────────────────────
# smith.langchain.com → Settings → API Keys

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sqlTool

# ── Optional: Vercel Cron auth ───────────────────────────────────────────────
# Any random secret string — Vercel sends this as Bearer token to /api/reports/cron
CRON_SECRET=
